{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/donde-voy.sh\" \"${CLAUDE_PROJECT_DIR:-.}\"",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/aviso-al-escribir.sh\" \"${CLAUDE_TOOL_FILE_PATH:-}\"",
            "async": true
          }
        ]
      }
    ]
  }
}
